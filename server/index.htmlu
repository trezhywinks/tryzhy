<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="description" content="Hello World">
  <meta name="author" content="curioso, why not?">
  <meta name="keywords" content="">
  <title>TryZhy</title>
</head>
<style>
body,html{background: #000; color:#fff; font-size:20px;}
.login{background: #151515; text-align: left; width: 670px; margin: 0 auto 10px; border-radius: 5px;}
.server{
text-align: center;} input{background: transparent; color:#fff; border:none; font-size: 20px; padding:10px;outline:none;}
.input{display:flex; height: 6vh; border-radius: 5px; overflow: hidden; background: #131313; width: 670px; justify-content: space-between; margin: 10px;}
.chat{margin-top: -10px; margin-right: 20px;}
.screen{ width: 100%;}
@media(max-width:999px){ .input{ width: 90%;}}
#pass{ width:100%;}
</style>
<body>
<div class="server">
<h2>Hello user!</h2>
<div class="login">
<label>Nickname</label>
<div class="input">
<input type="text" placeholder="Nickname" onblur='this.placeholder="Nickname"' onfocus='this.placeholder=""'/>
</div>
<label>Senha</label>
<div class="input">
<div class="screen">
<input type="password" placeholder="Senha" name="pass" id="pass" onblur='this.placeholder="Senha"' onfocus='this.placeholder=""'/>
</div>
<div class="chat"><p class="cli">Ve</p> </div>
<script>
document.querySelector('.cli').addEventListener('click', () => {
const pass = document.getElementById('pass');
const cli = document.querySelector('.cli');
if (pass.type === "password"){
pass.type = "text";
cli.innerText = "Es"
} else {
pass.type = "password";
cli.innerText = "Ve"

console.log("ta procurando oq cz?");
}
});
</script>
</div>
</div>
</div>
</body>
</html>
